# Copy this file to .env.local and fill it in. .env.local is gitignored — never commit it.
#
#   cp web/.env.example web/.env.local
#
# Nothing in .env.local is sent to the browser. It is read by the server only.

# --- Required -------------------------------------------------------------------

# Your rotated Gemini key, from https://aistudio.google.com/apikey
# Restrict it while you're there: scope it to the Generative Language API and set a
# quota cap. A leaked capped key costs money once; a leaked uncapped one keeps costing.
GEMINI_API_KEY=

# --- Strongly recommended before this is reachable by anyone else -----------------

# Shared passphrase. Leave blank for localhost-only use. Set it before you deploy —
# without it, anyone who finds the URL can spend your quota.
APP_PASSWORD=

# --- Optional -------------------------------------------------------------------

# Spend caps, per client. Defaults shown.
RATE_LIMIT_PER_MINUTE=15
RATE_LIMIT_PER_DAY=300

# Longest single message accepted, in characters.
MAX_INPUT_CHARS=8000

# How many past turns get resent as context. Higher = better memory, more tokens.
MAX_TURNS=20

# Override the model fallback chain (comma-separated, tried in order).
# Default: gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.0-flash
# GEMINI_MODEL_CHAIN=

# System prompt for the assistant.
# SYSTEM_PROMPT=You are a helpful assistant.
