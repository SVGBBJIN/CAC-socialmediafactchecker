# Copy this file to .env.local and fill it in. .env.local is gitignored — never commit it.
#
#   cp web/.env.example web/.env.local
#
# Nothing in .env.local is sent to the browser. It is read by the server only.

# --- Required -------------------------------------------------------------------

# Your rotated Gemini key, from https://aistudio.google.com/apikey
# Restrict it while you're there: scope it to the Generative Language API and set a
# quota cap. A leaked capped key costs money once; a leaked uncapped one keeps costing.
GEMINI_API_KEY=

# --- Strongly recommended before this is reachable by anyone else -----------------

# Shared passphrase. Leave blank for localhost-only use. Set it before you deploy —
# without it, anyone who finds the URL can spend your quota.
APP_PASSWORD=

# --- Web search: where the citations come from ------------------------------------
#
# The assistant is not allowed to assert a fact it did not retrieve, so search is the only
# way it learns anything. With no key set it falls back to scraping DuckDuckGo's HTML
# endpoint, which needs no account and is rate-limited without warning — fine for trying
# the app, not fine for anything anyone relies on. Set one of these before that matters.
#
# Whichever key is present is used, in this order: Brave, Tavily, Serper, Google.
#
# Names below are the canonical spelling, but casing doesn't matter — TAVILY_API_KEY,
# Tavily_API_key and tavily_api_key are all found. A key the app can't see doesn't error,
# it silently falls back to DuckDuckGo, which then gets blocked; `npm run dev` prints
# which provider it settled on, so check that line if searches start failing.

# https://brave.com/search/api/ — free tier, no card.
BRAVE_SEARCH_API_KEY=

# https://tavily.com — built for this use; returns cleaned page text with the results.
# Note: asking for `freshness` on a Tavily search also switches it to the news topic,
# because Tavily ignores the date window on any other topic.
TAVILY_API_KEY=

# https://serper.dev — Google results through an API.
SERPER_API_KEY=

# https://developers.google.com/custom-search/v1/overview — needs both halves: the API
# key and the search engine ID of a Programmable Search Engine set to search the whole web.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Force one provider when several keys are set. brave | tavily | serper | google | duckduckgo
# SEARCH_PROVIDER=

# Set to false to turn search off entirely. The citation audit goes with it — the
# assistant then answers from its training data, uncited and unchecked, which is exactly
# the behaviour this app exists to avoid. For debugging only.
# WEB_SEARCH_ENABLED=true

# --- Optional -------------------------------------------------------------------

# Spend caps, per client. Defaults shown.
RATE_LIMIT_PER_MINUTE=15
RATE_LIMIT_PER_DAY=300

# Longest single message accepted, in characters.
MAX_INPUT_CHARS=8000

# Longest one request may run before it stops itself and reports a partial answer, in
# seconds. Set this a few seconds BELOW whatever your host allows — on Vercel that is
# Settings → Functions → Max Duration (10s by default on Hobby, 60s ceiling there, 300s on
# Pro). It matters because a host enforces its limit by killing the process, which on a
# streaming response closes the connection with no error at all: the reader gets a
# half-written fact-check with nothing to say it was cut off. Stopping first is what buys
# the explanation.
MAX_REQUEST_SECONDS=55

# How many past turns get resent as context. Higher = better memory, more tokens.
MAX_TURNS=20

# Longest single reply Gemini may generate, in tokens. Output tokens cost more than
# input ones, and unlike everything else above, nothing capped this before.
MAX_OUTPUT_TOKENS=4096

# Override the model fallback chain (comma-separated, tried in order).
# Default: gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.0-flash
# GEMINI_MODEL_CHAIN=

# System prompt for the assistant. The default is the fact-checking prompt in
# web/lib/verified-chat.js: it tells the model its facts come from the web_search tool and
# that every claim needs a citation. Overriding it replaces the *instruction* only — the
# citation audit still runs, and an answer that cites nothing is still sent back for a
# rewrite. Override with care; a prompt that doesn't mention the rule makes the model fail
# the audit and answer slowly rather than making it answer freely.
# SYSTEM_PROMPT=You are a helpful assistant.
