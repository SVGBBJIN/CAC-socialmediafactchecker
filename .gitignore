.DS_Store

# Secrets — never commit plaintext credentials.
*.enc
secrets.json

# `.env` alone does not match `.env.local`, which is where the web chat's key lives.
# Match every variant, then re-admit the committed template.
.env
.env.*
!.env.example

# Web chat
node_modules/
.vercel/

# design-sync (TRASE DS) — machine state, never committed
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
/web/design-system/node_modules/
/web/design-system/dist/
