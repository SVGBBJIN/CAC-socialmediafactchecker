.DS_Store
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# Secrets — never commit plaintext credentials.
# `Secrets.xcconfig` holds the provisioning-time plaintext; `secrets.enc` is the
# encrypted blob produced from it by Scripts/encrypt-secrets.sh. Neither belongs
# in git. See docs/SECRETS.md.
Secrets.xcconfig
*.enc
secrets.json

# `.env` alone does not match `.env.local`, which is where the web chat's key lives.
# Match every variant, then re-admit the committed template.
.env
.env.*
!.env.example

# Web chat
node_modules/
.vercel/
